import {
  "moonbitlang/core/cmp",
  "moonbitlang/core/string",
  "moonbitlang/core/buffer",
  "tonyfettes/sync/io",
  "tonyfettes/sync/socket",
  "tonyfettes/sync/tls",
  "tonyfettes/sync/internal/io_buffer",
  "tonyfettes/sync/internal/gzip_internal" @gzip,
}

import {
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
} for "test"

import {
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
} for "wbtest"

supported_targets = "native"

options(
  targets: {
    "client.mbt": [ "native" ],
    "cookie_wbtest.mbt": [ "native" ],
    "cookie.mbt": [ "native" ],
    "deprecated.mbt": [ "native" ],
    "http_wbtest.mbt": [ "native" ],
    "parser.mbt": [ "native" ],
    "parser_wbtest.mbt": [ "native" ],
    "request.mbt": [ "native" ],
    "resolve_url_wbtest.mbt": [ "native" ],
    "send.mbt": [ "native" ],
    "server.mbt": [ "native" ],
    "types.mbt": [ "native" ],
    "utils.mbt": [ "native" ],
  },
)
