import {
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/cmp",
  "tonyfettes/sync/io",
  "tonyfettes/sync/internal/bytes_util",
  "tonyfettes/sync/internal/c_buffer",
  "tonyfettes/sync/internal/io_buffer",
  "tonyfettes/sync/internal/os_string",
  "tonyfettes/sync/os_error",
  "tonyfettes/sync/fs",
}

supported_targets = "native"

options(
  "native-stub": [ "openssl.c", "schannel.c" ],
  targets: {
    "crypto_util.mbt": [ "native" ],
    "deprecated.mbt": [ "native" ],
    "openssl.mbt": [ "native" ],
    "openssl_loader.mbt": [ "native" ],
    "schannel.mbt": [ "native" ],
    "tls.mbt": [ "native" ],
    "transport.mbt": [ "native" ],
  },
)
